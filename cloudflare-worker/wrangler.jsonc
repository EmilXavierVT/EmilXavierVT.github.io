{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emil-portfolio-rag-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-10-16",
  "observability": {
    "enabled": true
  },
  "vars": {
    "DIFY_BASE_URL": "https://api.dify.ai/v1",
    "ALLOWED_ORIGINS": "http://localhost:1313,http://localhost:1314,https://emilxaviervt.github.io"
  },
  "secrets": {
    "required": ["DIFY_APP_API_KEY"]
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "12026001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
